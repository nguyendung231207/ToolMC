# ==========================================
# ToolMC Auth & Management Backend (.env)
# ==========================================

# JWT Secret Key (Used for signing & verifying session/access tokens)
# Generate a secure random string (e.g., using `openssl rand -hex 32`)
JWT_SECRET="your-jwt-secret-key-here"

# Vuotlink API Configuration (For link shortening with ads)
# Get your API key from https://vuotlink.vip
VUOTLINK_API_KEY="your-vuotlink-api-key"

# Redis Connection URL (Upstash Redis or Self-hosted Redis)
# Example: "rediss://default:password@your-endpoint.upstash.io:6379"
REDIS_URL=""

# Admin Dashboard Password SHA-256 Hash
# Default hash for "admin123" is: 240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9
# Generate hash at: https://emn178.github.io/online-tools/sha256.html
ADMIN_PASSWORD_HASH=""

# RSA Private Key for Server Verification Signature
# Generate key pair at: https://travistidwell.com/jsencrypt/demo/
# Keep the PRIVATE key in this .env file, and place the corresponding PUBLIC key in `src/main/js/auth/authHandler.js`
RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
YOUR_RSA_PRIVATE_KEY_HERE
-----END RSA PRIVATE KEY-----"
